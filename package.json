{
  "name": "vim-clay",
  "version": "0.1.0",
  "private": true,
  "description": "Learn vim motions by doing them, in a real vim editor, in your browser. No sign-in, no backend.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/csp-check.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:exercises": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-test-resolver.mjs scripts/verify-exercises.ts",
    "csp:hashes": "node scripts/csp-hashes.mjs",
    "csp:check": "node scripts/csp-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "verify": "npm run format:check && npm run lint && tsc --noEmit && npm test && npm run verify:exercises",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@replit/codemirror-vim": "6.4.0",
    "clsx": "^2.1.1",
    "next": "^15.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
